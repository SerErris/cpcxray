# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Windows download markers (WSL)
*:Zone.Identifier

# ROM images are never committed (NFR-07); generated output stays local
roms/*
!roms/.gitignore
output/*
!output/.gitignore

# External test vectors (tools/fetch_test_data.sh)
tests/data/external/

# Third-party reference documents kept locally only (linked from docs/design.md §10)
docs/*.pdf
