# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Windows download markers (WSL)
*:Zone.Identifier

# ROM images are never committed (NFR-07); generated output stays local
roms/*
!roms/.gitignore
output/*
!output/.gitignore
project/*
!project/.gitignore

# External test vectors (tools/fetch_test_data.sh)
tests/data/external/

# Third-party reference documents kept locally only (linked from docs/design.md §10)
docs/*.pdf

# Assembled test programs (built by the tests with sjasmplus)
tests/data/asm/*.bin

# Disk images (real images are local only, like ROMs)
/disk/

# local material of a separate project, not part of cpcxray
vdos/
